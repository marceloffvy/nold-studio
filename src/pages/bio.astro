---
import Layout from "../layouts/Layout.astro";

const email = "marcelomelo.nold@gmail.com";
const whatsapp = "5511996465055";
const waText = encodeURIComponent("Olá! Vim pelo link da bio da Nold e quero conversar.");
const waLink = `https://wa.me/${whatsapp}?text=${waText}`;
const instagram = "https://instagram.com/nold.studio";

const destaque = {
  kicker: "Estúdio criativo",
  title: "Nold Studio",
  desc: "Branding, conteúdo e performance movidos por estratégia.",
  href: "/",
};

const secundarios = [
  {
    nome: "Para doutores",
    desc: "Marketing para médicos e dentistas",
    href: "/marketing-para-doutores",
  },
];
---

<Layout
  title="Nold Studio — Link na bio"
  description="Branding, conteúdo e performance movidos por estratégia. Fale com a Nold."
  bodyClass="bio-body"
>
  <main class="bio">
    <header class="bio-head">
      <img class="bio-logo" src="/brand/wordmark-nold.png" width="320" height="167" alt="Nold" />
      <p class="bio-tagline"><span class="dot" aria-hidden="true"></span>Branding · Conteúdo · Performance</p>
    </header>

    <nav class="bio-social" aria-label="Redes sociais">
      <a href={instagram} target="_blank" rel="noopener" aria-label="Instagram">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4.2" />
          <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
        </svg>
      </a>
      <a href={waLink} target="_blank" rel="noopener" aria-label="WhatsApp">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51-.17-.01-.37-.01-.57-.01-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.7.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z" />
          <path d="M12.04 2C6.56 2 2.06 6.5 2.06 11.99c0 1.8.47 3.56 1.37 5.11L2 22l5.05-1.33a9.97 9.97 0 0 0 5 1.33c5.48 0 9.98-4.5 9.98-9.99A9.93 9.93 0 0 0 12.04 2Zm5.9 15.87a8.29 8.29 0 0 1-5.9 2.44 8.29 8.29 0 0 1-4.21-1.15l-.3-.18-3 .79.8-2.92-.2-.31a8.27 8.27 0 0 1-1.27-4.41c0-4.58 3.73-8.31 8.31-8.31 2.22 0 4.31.87 5.88 2.44a8.26 8.26 0 0 1 2.43 5.88c0 4.58-3.73 8.31-8.31 8.31Z" />
        </svg>
      </a>
      <a href={`mailto:${email}`} aria-label="E-mail">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="3" />
          <path d="m4 7 8 6 8-6" />
        </svg>
      </a>
    </nav>

    <a class="bio-highlight" href={destaque.href}>
      <span class="bio-highlight__kicker"><span aria-hidden="true">✦</span> {destaque.kicker}</span>
      <span class="bio-highlight__title">{destaque.title}</span>
      <span class="bio-highlight__foot">
        <span>{destaque.desc}</span>
        <span class="bio-arw" aria-hidden="true">↗</span>
      </span>
    </a>

    <div class="bio-grid">
      {secundarios.map((s) => (
        <a class="bio-card" href={s.href}>
          <span class="bio-card__top">
            <span class="bio-card__name">{s.nome}</span>
            <span class="bio-arw bio-arw--sm" aria-hidden="true">↗</span>
          </span>
          <span class="bio-card__desc">{s.desc}</span>
        </a>
      ))}
    </div>

    <a class="bio-cta" href={waLink} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51-.17-.01-.37-.01-.57-.01-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.7.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z" />
        <path d="M12.04 2C6.56 2 2.06 6.5 2.06 11.99c0 1.8.47 3.56 1.37 5.11L2 22l5.05-1.33a9.97 9.97 0 0 0 5 1.33c5.48 0 9.98-4.5 9.98-9.99A9.93 9.93 0 0 0 12.04 2Zm5.9 15.87a8.29 8.29 0 0 1-5.9 2.44 8.29 8.29 0 0 1-4.21-1.15l-.3-.18-3 .79.8-2.92-.2-.31a8.27 8.27 0 0 1-1.27-4.41c0-4.58 3.73-8.31 8.31-8.31 2.22 0 4.31.87 5.88 2.44a8.26 8.26 0 0 1 2.43 5.88c0 4.58-3.73 8.31-8.31 8.31Z" />
      </svg>
      Fale com a nossa equipe
    </a>

    <p class="bio-foot">© Nold Studio 2026 · Todos os direitos reservados</p>
  </main>
</Layout>

<style is:global>
  body.bio-body {
    --bio-bg: #04231b;
    --bio-card: #0a4132;
    --bio-border: rgba(246, 246, 246, 0.14);
    --bio-yellow: #fdca40;
    --bio-white: #f6f6f6;
    --bio-gray: rgba(246, 246, 246, 0.58);
    --bio-title: "DtHebrinks", Georgia, "Times New Roman", serif;
    --bio-mono: "IBMPlexMono", ui-monospace, "SFMono-Regular", Menlo, monospace;
    --bio-ui: "Aeonik", system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
    margin: 0;
    background: var(--bio-bg);
    background-image: radial-gradient(rgba(246, 246, 246, 0.05) 1.2px, transparent 1.3px);
    background-size: 26px 26px;
    color: var(--bio-white);
    font-family: var(--bio-ui);
    -webkit-font-smoothing: antialiased;
  }

  .bio {
    min-height: 100svh;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: clamp(2.5rem, 8vh, 5rem) 1.4rem;
  }
  .bio > * { width: 100%; max-width: 420px; }

  .bio-head { display: flex; flex-direction: column; align-items: center; gap: 0.7rem; text-align: center; }
  .bio-logo { width: 96px; height: auto; filter: brightness(0) invert(1); }
  .bio-tagline { margin: 0; display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--bio-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--bio-gray); }
  .bio-tagline .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--bio-yellow); flex: 0 0 auto; }

  .bio-social { display: flex; justify-content: center; gap: 0.9rem; margin-top: 1.6rem; }
  .bio-social a {
    display: flex; align-items: center; justify-content: center;
    width: 42px; height: 42px; border-radius: 50%;
    border: 1px solid var(--bio-border); color: var(--bio-white);
    transition: border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .bio-social a svg { width: 19px; height: 19px; }
  .bio-social a:hover { border-color: var(--bio-yellow); color: var(--bio-yellow); transform: translateY(-2px); }

  .bio-highlight {
    position: relative; overflow: hidden; display: block; margin-top: 1.8rem;
    padding: clamp(1.3rem, 4vw, 1.7rem);
    border-radius: 20px;
    background: linear-gradient(180deg, #0d4a39, var(--bio-card));
    border: 1px solid var(--bio-border);
    text-decoration: none; color: var(--bio-white);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .bio-highlight::before {
    content: ""; position: absolute; top: -60%; left: -20%; width: 140%; height: 140%;
    background: radial-gradient(circle, rgba(253, 202, 64, 0.16), transparent 60%);
    pointer-events: none;
  }
  .bio-highlight:hover { transform: translateY(-3px); border-color: rgba(253, 202, 64, 0.5); }
  .bio-highlight__kicker { position: relative; display: flex; align-items: center; gap: 0.45rem; font-family: var(--bio-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--bio-yellow); }
  .bio-highlight__title { position: relative; display: block; margin-top: 0.5rem; font-family: var(--bio-title); font-size: clamp(1.8rem, 6vw, 2.2rem); line-height: 1.05; }
  .bio-highlight__foot { position: relative; margin-top: 0.9rem; display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; }
  .bio-highlight__foot span:first-child { color: var(--bio-gray); font-size: 0.92rem; line-height: 1.4; max-width: 26ch; }

  .bio-arw {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 50%; background: var(--bio-yellow); color: #04231b;
    font-size: 1rem;
  }
  .bio-arw--sm { width: 26px; height: 26px; background: transparent; border: 1px solid var(--bio-border); color: var(--bio-white); font-size: 0.85rem; }

  .bio-grid { margin-top: 0.85rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.85rem; }
  .bio-card {
    display: flex; flex-direction: column; gap: 0.5rem; justify-content: space-between;
    padding: 1.05rem 1.1rem; min-height: 96px;
    border-radius: 16px; background: var(--bio-card); border: 1px solid var(--bio-border);
    text-decoration: none; color: var(--bio-white);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .bio-card:hover { transform: translateY(-2px); border-color: rgba(253, 202, 64, 0.45); }
  .bio-card__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.6rem; }
  .bio-card__name { font-family: var(--bio-title); font-size: 1.15rem; line-height: 1.15; }
  .bio-card__desc { color: var(--bio-gray); font-size: 0.82rem; line-height: 1.4; }

  .bio-cta {
    margin-top: 1.4rem; display: flex; align-items: center; justify-content: center; gap: 0.6rem;
    padding: 1rem 1.2rem; border-radius: 999px;
    background: var(--bio-yellow); color: #04231b;
    font-family: var(--bio-ui); font-weight: 600; font-size: 0.98rem;
    text-decoration: none;
    transition: transform 0.25s ease, filter 0.25s ease;
  }
  .bio-cta svg { width: 19px; height: 19px; }
  .bio-cta:hover { transform: translateY(-2px); filter: brightness(1.06); }

  .bio-foot { margin-top: 1.6rem; text-align: center; font-family: var(--bio-mono); font-size: 0.68rem; letter-spacing: 0.04em; color: var(--bio-gray); }
</style>
