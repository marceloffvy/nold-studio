---
import Layout from "../layouts/Layout.astro";

const email = "studio@nold.studio"; // DADO: confirmar e-mail oficial

// ===== PRIMEIRO BLOCO — "o apanhado" =====
// Colagem masonry em 2 macro-colunas (como a referência): a coluna direita
// nasce deslocada; trio final alinhado à esquerda com respiro à direita.
// A estrutura é intencional demais para data-map — markup direto na seção.

// DADO: confirmar grafias — "Hospitalar", "Odontogon", "Roberto Simonetti"
const clients = [
  "MaxFocos", "Clínica LK", "Biliart", "Dela Bella", "Kaju",
  "Biva", "Marcelo Tavares", "Roberto Simonetti", "Hospitalar", "Odontogon",
];

// Manifesto — os 3 pilares (seção escura, scroll-reveal)
const services = [
  {
    ghost: "branding",
    name: "Branding",
    text: "Posicionamento do zero ao DNA criativo. A diferença entre ser único no seu segmento e ser só mais um.",
    tags: "Estratégia / Posicionamento / DNA verbal / Sistema de identidade",
  },
  {
    ghost: "conteúdo",
    name: "Conteúdo",
    text: "Produção estratégica que posiciona e converte. Estética a serviço da percepção de valor — não de vaidade.",
    tags: "Direção de arte / Vídeo / Linha editorial / Social / Retainer",
  },
  {
    ghost: "performance",
    name: "Performance",
    text: "Captação ativa de clientes para a marca. Beleza estratégica que vira pipeline, não só portfólio.",
    tags: "Aquisição / Mídia paga / Funis / Leitura de dados",
  },
];

// ===== BRANDING — 5 motions de identidade (1:1, autoplay) =====
const brandingWork = [
  { name: "MaxFocos", meta: "Suplementos", video: "/videos/branding/maxfocos.mp4" },
  { name: "Biliart", meta: "Odontologia estética", video: "/videos/branding/biliart.mp4" },
  { name: "Biva", meta: "Arquitetura", video: "/videos/branding/biva.mp4" },
  { name: "Dela Bella", meta: "Beleza", video: "/videos/branding/delabela.mp4" },
  { name: "Kaju", meta: "Marca própria", video: "/videos/branding/kaju.mp4" },
];

// ===== CONTEÚDO — parede de reels 9:16 (pôster + clique) =====
// DADO: rótulos (cat/name) editáveis — confirmar cliente/tema de cada reel.
const reels = [
  { cat: "Odontologia", name: "As lentes que você deseja", file: "b27" },
  { cat: "Bastidor", name: "Vlog · Dia de cirurgia", file: "b49" },
  { cat: "Relato", name: "Cirurgia ortognática", file: "b50" },
  { cat: "Educativo", name: "Queixo: pra frente ou pra trás?", file: "b65" },
  { cat: "Depoimento", name: "Paciente", file: "depoimento" },
  { cat: "Educativo", name: "Diferença do alinhador", file: "id32" },
  { cat: "Educativo", name: "3 coisas antes da prótese", file: "lk18" },
  { cat: "Educativo", name: "Se o siso pode matar", file: "m55" },
  { cat: "Estética", name: "Lipo de papada", file: "m57" },
  { cat: "Educativo", name: "Plano de 6 meses", file: "m76" },
  { cat: "Depoimento", name: "Paciente", file: "mt06" },
  { cat: "Depoimento", name: "Paciente", file: "mt10" },
];

// ===== PERFORMANCE — resultados (1:1) + números =====
const perf = [
  { name: "MaxFocos", meta: "Lançamento", video: "/videos/campanhas/maxfocos.mp4" },
  { name: "Clínica LK", meta: "Campanha", video: "/videos/campanhas/lk.mp4" },
  { name: "Biva", meta: "Projeto", video: "/videos/campanhas/biva.mp4" },
];

// Projetos autorais: colagem escalonada hardcoded na seção (placeholders).
---

<Layout>
  <!-- ============================ TOPBAR ============================ -->
  <header class="topbar">
    <div class="container topbar__inner">
      <a href="/" class="logo-card" aria-label="Nold — início">
        <span style="font-family:var(--font-title); font-size:1.9rem; line-height:1; color:var(--green)">n</span>
      </a>

      <div class="meta">
        <span class="meta__pair">São Paulo <b data-clock>--:--</b></span>
        <button class="copy-btn" type="button" data-copy={email} aria-label="Copiar e-mail">
          <span data-copy-label>{email}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" />
          </svg>
        </button>
      </div>

      <nav class="nav-pill" aria-label="Navegação principal">
        <a href="#trabalho">Projetos</a>
        <a href="#conteudo">Conteúdo</a>
        <a href={`mailto:${email}`} class="hi">Olá! <span aria-hidden="true">💬</span></a>
      </nav>
    </div>
  </header>

  <main>
    <!-- ============================ HERO ============================ -->
    <section class="hero container">
      <h1 class="hero__display">
        Seu negócio merece<br />
        ser <em>inevitável</em>.
      </h1>

      <p class="hero__sub">
        Construímos e escalamos marcas que não aceitam o genérico. Branding,
        conteúdo e performance numa esteira só — entregue com tecnologia, bom
        gosto e velocidade premium.
      </p>

      <div class="hero__actions">
        <a href="#estudio" class="text-link">
          Conheça o estúdio <span class="arw" aria-hidden="true">→</span>
        </a>
        <a href="#trabalho" class="text-link">
          Veja o trabalho <span class="arw" aria-hidden="true">→</span>
        </a>
        <span class="ball" data-ball aria-hidden="true"></span>
      </div>
    </section>

    <!-- ============ O APANHADO (colagem masonry, full-bleed) ============ -->
    <section class="collage-wrap" id="trabalho">
      <div class="collage">
        <!-- Macro-coluna esquerda: feature grande + par de identidades -->
        <div class="mcol">
          <article class="tile tile--sq">
            <video src="/videos/nold-entregas.mp4" autoplay loop muted playsinline preload="metadata"></video>
            <span class="tile__tag">Nold · Entregas</span>
          </article>
          <div class="pair">
            <article class="tile tile--sq">
              <video src="/videos/branding/kaju.mp4" autoplay loop muted playsinline preload="metadata"></video>
              <span class="tile__tag">Branding</span>
            </article>
            <article class="tile tile--sq">
              <video src="/videos/branding/biva.mp4" autoplay loop muted playsinline preload="metadata"></video>
              <span class="tile__tag">Branding</span>
            </article>
          </div>
        </div>

        <!-- Macro-coluna direita: identidade + performance MaxFocos lado a
             lado; verticais de conteúdo quase na primeira dobra -->
        <div class="mcol mcol--late">
          <div class="pair">
            <article class="tile tile--sq">
              <video src="/videos/branding/maxfocos.mp4" autoplay loop muted playsinline preload="metadata"></video>
              <span class="tile__tag">Branding</span>
            </article>
            <article class="tile tile--sq">
              <video src="/videos/campanhas/maxfocos.mp4" autoplay loop muted playsinline preload="metadata"></video>
              <span class="tile__tag">Performance</span>
            </article>
          </div>
          <div class="pair">
            <article class="tile tile--v">
              <video src="/videos/reels/b50.mp4" autoplay loop muted playsinline preload="metadata"></video>
              <span class="tile__tag">Conteúdo</span>
            </article>
            <article class="tile tile--v">
              <video src="/videos/reels/m55.mp4" autoplay loop muted playsinline preload="metadata"></video>
              <span class="tile__tag">Conteúdo</span>
            </article>
          </div>
        </div>
      </div>

      <!-- Fecho: LK no cantinho esquerdo (abaixo de Kaju/Biva) + marca -->
      <div class="trio">
        <article class="tile tile--sq">
          <video src="/videos/campanhas/lk.mp4" autoplay loop muted playsinline preload="metadata"></video>
          <span class="tile__tag">Performance</span>
        </article>
        <a class="brand-tile stag" href="#conteudo">
          <span class="brand-tile__wm">nold</span>
          <span class="brand-tile__link">Ver tudo <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </section>

    <!-- ================= CLIENTES (marquee automático) ================= -->
    <section class="section container clients">
      <p class="eyebrow clients__label">Confiam na curadoria</p>
      <div class="marquee" aria-label="Clientes">
        {/* ASSET: trocar wordmarks por logos SVG reais */}
        <div class="marquee__track">
          <div class="marquee__group">
            {clients.map((c) => <span class="client-ph">{c}</span>)}
          </div>
          <div class="marquee__group" aria-hidden="true">
            {clients.map((c) => <span class="client-ph">{c}</span>)}
          </div>
        </div>
      </div>
    </section>

    <!-- ================= ESTÚDIO (manifesto escuro) ================= -->
    <section id="estudio">
      <div class="studio">
        <p class="studio__statement">
          Operamos numa esteira única — estratégia, <em>estética</em> e tecnologia
          juntas para construir marcas que despertam <em>desejo</em> e escalam de verdade.
        </p>

        <!-- ① BRANDING: descrição + identidades logo abaixo -->
        <div class="service" id="branding">
          <span class="service__ghost" aria-hidden="true">{services[0].ghost}</span>
          <div class="service__body">
            <p class="service__text">
              <em class="service__name">{services[0].name}</em><span class="reveal"> — {services[0].text}</span>
            </p>
            <p class="service__tags">{services[0].tags}</p>
            <div class="service__work service__work--b">
              {
                brandingWork.map((b) => (
                  <article class="tile tile--sq">
                    <video src={b.video} autoplay loop muted playsinline preload="metadata" />
                    <span class="tile__tag">{b.name}</span>
                  </article>
                ))
              }
            </div>
          </div>
        </div>

        <!-- ② CONTEÚDO: descrição + carrossel de reels dentro do quadrante -->
        <div class="service" id="conteudo">
          <span class="service__ghost" aria-hidden="true">{services[1].ghost}</span>
          <div class="service__body">
            <p class="service__text">
              <em class="service__name">{services[1].name}</em><span class="reveal"> — {services[1].text}</span>
            </p>
            <p class="service__tags">{services[1].tags}</p>
            <p class="reels-hint">Arraste para o lado · clique para assistir com som →</p>
            <div class="reels-strip reels-strip--in" data-reels>
              {
                reels.map((r) => (
                  <button class="reel-card" data-reel={`/videos/reels/${r.file}.mp4`} aria-label={`Assistir: ${r.name}`}>
                    <img class="reel-card__poster" src={`/videos/posters/${r.file}.jpg`} width="540" height="960" loading="lazy" alt="" />
                    <span class="reel-card__play" aria-hidden="true">▶</span>
                    <span class="tile__tag">{r.cat}</span>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <!-- ③ PERFORMANCE: descrição + resultados logo abaixo -->
        <div class="service" id="performance">
          <span class="service__ghost" aria-hidden="true">{services[2].ghost}</span>
          <div class="service__body">
            <p class="service__text">
              <em class="service__name">{services[2].name}</em><span class="reveal"> — {services[2].text}</span>
            </p>
            <p class="service__tags">{services[2].tags}</p>
            <div class="service__work service__work--p">
              {
                perf.map((p) => (
                  <article class="tile tile--sq">
                    <video src={p.video} autoplay loop muted playsinline preload="metadata" />
                    <span class="tile__tag">{p.name}</span>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ AUTORAIS (colagem escalonada, full-bleed) ============ -->
    <section class="section" id="autorais">
      <div class="container">
        <h2 class="autoral__head">
          Trabalho de cliente é só parte. Veja o que criamos por <em>conta própria</em>.
        </h2>
      </div>
      <div class="collage-wrap">
        <div class="collage2">
          <!-- col 1: nasce bem abaixo -->
          <div class="c2col c2col--d1">
            <div class="ph tile--sq">
              <span class="ph__tag">Marca</span>
              <span class="ph__name">Kaju</span>
              <span class="ph__meta">Marca própria do estúdio</span>
            </div>
          </div>
          <!-- col 2: par pequeno + 4:3 -->
          <div class="c2col c2col--d2">
            <div class="tinypair">
              <div class="ph tile--sq">
                <span class="ph__tag">Colagem</span>
                <span class="ph__name">Sleep Mode</span>
              </div>
              <div class="ph tile--sq">
                <span class="ph__tag">Colagem</span>
                <span class="ph__name">Renascença</span>
              </div>
            </div>
            <div class="ph tile--43">
              <span class="ph__tag">Motion</span>
              <span class="ph__name">Afresco</span>
              <span class="ph__meta">Barroco em movimento</span>
            </div>
          </div>
          <!-- col 3: vertical 2:3 -->
          <div class="c2col c2col--d3">
            {/* ASSET: animação do sistema operacional pessoal (a caminho) */}
            <div class="ph tile--23">
              <span class="ph__tag">Software</span>
              <span class="ph__name">Brand Brain</span>
              <span class="ph__meta">Sistema operacional pessoal · CRM · Gestão · LPs</span>
            </div>
          </div>
          <!-- col 4: 3:2 + quadrado -->
          <div class="c2col">
            <div class="ph tile--32">
              <span class="ph__tag">Colagem</span>
              <span class="ph__name">Glitch Barroco</span>
            </div>
            <div class="ph tile--sq">
              <span class="ph__tag">Marca</span>
              <span class="ph__name">Vortz</span>
              <span class="ph__meta">Arquitetura</span>
            </div>
          </div>
        </div>
        <!-- banner cinematográfico full-bleed -->
        <div class="ph banner">
          <span class="ph__tag">Filme</span>
          <span class="ph__name">Anacrônico</span>
          <span class="ph__meta">Retrofuturismo · clássico × máquina</span>
        </div>
      </div>
    </section>

    <!-- =========================== CTA =========================== -->
    <section class="section container cta">
      <h2 class="cta__title">Sua marca merece<br />ser <em>inevitável</em>.</h2>
      <p class="cta__sub">
        Para empresas a partir de R$ 150k/mês prontas para reposicionar e escalar.
        Se você não aceita genérico, a gente se entende.
      </p>
      <a href={`mailto:${email}`} class="cta__email">
        {email} <span aria-hidden="true">→</span>
      </a>
    </section>

    <!-- ======================= NEWSLETTER ======================= -->
    <section class="section container newsletter">
      <div class="newsletter__inner">
        <div>
          <h3>Fique no radar.</h3>
          <p>Bastidores do estúdio, estética aplicada a negócio e o que estamos construindo. Sem ruído.</p>
        </div>
        {/* INTEGRAÇÃO: conectar a um provedor (Resend / Mailchimp) */}
        <form action="#" method="post">
          <input type="email" name="email" placeholder="seu@email.com" aria-label="Seu e-mail" required />
          <button type="submit">Assinar →</button>
        </form>
      </div>
    </section>
  </main>

  <!-- ============================ FOOTER ============================ -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer__top">
        <div class="footer__brand">
          <span class="wm">nold</span>
          <span class="sub">Studio Criativo</span>
        </div>
        <div class="footer__col">
          <h4>Navegação</h4>
          <ul>
            <li><a href="#trabalho">Trabalho</a></li>
            <li><a href="#branding">Branding</a></li>
            <li><a href="#conteudo">Conteúdo</a></li>
            <li><a href="#performance">Performance</a></li>
          </ul>
        </div>
        <div class="footer__col">
          <h4>Social</h4>
          <ul>
            {/* DADO: confirmar @ e URLs reais */}
            <li><a href="#">Instagram ↗</a></li>
            <li><a href="#">Behance ↗</a></li>
            <li><a href="#">LinkedIn ↗</a></li>
            <li><a href={`mailto:${email}`}>{email}</a></li>
          </ul>
        </div>
      </div>
      <div class="footer__bottom">
        <span>© 2026 Nold Studio</span>
        <span>Beleza estratégica · Movido a IA</span>
      </div>
    </div>
  </footer>

  <!-- ========================= LIGHTBOX ========================= -->
  <div class="lightbox" data-lightbox hidden>
    <button class="lightbox__close" data-lb-close aria-label="Fechar">✕</button>
    <video class="lightbox__video" data-lb-video controls playsinline></video>
  </div>
</Layout>

<script>
  // Relógio de São Paulo
  const fmt = new Intl.DateTimeFormat("pt-BR", {
    hour: "2-digit", minute: "2-digit", timeZone: "America/Sao_Paulo",
  });
  function tick() {
    document.querySelectorAll("[data-clock]").forEach((el) => {
      el.textContent = fmt.format(new Date());
    });
  }
  tick();
  setInterval(tick, 15000);

  // Copiar e-mail
  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.getAttribute("data-copy"));
        const label = btn.querySelector("[data-copy-label]") || btn;
        const old = label.textContent;
        label.textContent = "copiado ✓";
        setTimeout(() => (label.textContent = old), 1400);
      } catch (e) {}
    });
  });

  // Reveal palavra-a-palavra. .reveal contém só texto puro -> split limpo.
  const reveals = Array.from(document.querySelectorAll(".reveal"));
  reveals.forEach((el) => {
    if (el.dataset.r) return; // idempotente (evita corromper em HMR)
    const text = el.textContent;
    el.textContent = "";
    text.split(/(\s+)/).forEach((tok) => {
      if (tok.trim() === "") el.appendChild(document.createTextNode(tok));
      else {
        const s = document.createElement("span");
        s.className = "w";
        s.textContent = tok;
        el.appendChild(s);
      }
    });
    el.dataset.r = "1";
    el.classList.add("is-ready");
  });

  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const vh = window.innerHeight;
      reveals.forEach((el) => {
        const ws = el.querySelectorAll(".w");
        const r = el.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (vh * 0.72 - r.top) / (r.height || 1)));
        const n = Math.round(p * ws.length);
        ws.forEach((w, i) => w.classList.toggle("on", i < n));
      });
      ticking = false;
    });
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
  onScroll();

  // Lightbox dos reels (carrega o vídeo só no clique)
  const lb = document.querySelector("[data-lightbox]");
  const lbVideo = document.querySelector("[data-lb-video]");
  function openLB(src) {
    if (!lb || !lbVideo) return;
    lbVideo.src = src;
    lb.hidden = false;
    document.body.style.overflow = "hidden";
    lbVideo.play().catch(() => {});
  }
  function closeLB() {
    if (!lb || !lbVideo) return;
    lbVideo.pause();
    lbVideo.removeAttribute("src");
    lbVideo.load();
    lb.hidden = true;
    document.body.style.overflow = "";
  }
  document.querySelectorAll("[data-reel]").forEach((b) => {
    b.addEventListener("click", () => openLB(b.getAttribute("data-reel")));
  });
  document.querySelector("[data-lb-close]")?.addEventListener("click", closeLB);
  lb?.addEventListener("click", (e) => { if (e.target === lb) closeLB(); });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && lb && !lb.hidden) closeLB();
  });

  // Bolinha "física" arrastável (detalhe lúdico)
  document.querySelectorAll("[data-ball]").forEach((ball) => {
    let dragging = false, sx = 0, sy = 0, x = 0, y = 0;
    ball.addEventListener("pointerdown", (e) => {
      dragging = true; sx = e.clientX - x; sy = e.clientY - y;
      ball.setPointerCapture(e.pointerId);
    });
    ball.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      x = e.clientX - sx; y = e.clientY - sy;
      ball.style.transform = `translate(${x}px, ${y}px)`;
    });
    ball.addEventListener("pointerup", () => {
      dragging = false;
      ball.style.transition = "transform .6s cubic-bezier(.22,1,.36,1)";
      ball.style.transform = "translate(0,0)";
      x = 0; y = 0;
      setTimeout(() => (ball.style.transition = ""), 600);
    });
  });
</script>
