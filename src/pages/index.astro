---
import Layout from "../layouts/Layout.astro";

const email = "marcelomelo.nold@gmail.com"; // e-mail exibido no header + destino do formulário
const formEmail = email;
const whatsapp = "5511996465055"; // WhatsApp corporativo (+55 11 99646-5055)
const waText = encodeURIComponent(
  "Olá! Vim pelo site da Nold e quero falar com um especialista sobre reposicionar e escalar minha marca.",
);
const waLink = `https://wa.me/${whatsapp}?text=${waText}`;
const instagram = "https://instagram.com/nold.studio"; // DADO: confirmar @

const segmentos = [
  "Odontologia", "Medicina", "Estética & Beleza", "Saúde",
  "Advocacia", "Engenharia", "Construção civil", "Imobiliário & Incorporação",
  "Startups", "Tecnologia", "Logística", "Consultoria",
  "Infoproduto", "Educação", "Institutos", "Outro",
];

// ===== PRIMEIRO BLOCO — "o apanhado" =====
// Colagem masonry em 2 macro-colunas (como a referência): a coluna direita
// nasce deslocada; trio final alinhado à esquerda com respiro à direita.
// A estrutura é intencional demais para data-map — markup direto na seção.

// DADO: confirmar grafias — "Hospitalar", "Odontogon", "Roberto Simonetti"
const clients = [
  "MaxFocos", "Clínica LK", "Biliart", "Dela Bella", "Kaju",
  "Biva", "Marcelo Tavares", "Roberto Simonetti", "Hospitalar", "Odontogon",
];

// Manifesto — os 3 pilares (seção escura, scroll-reveal)
const services = [
  {
    ghost: "branding",
    name: "Branding",
    text: "Posicionamento ou reposicionamento de marca, do conceito à experiência digital do cliente. A diferença entre ser único no seu segmento e ser só mais um.",
    tags: "Estratégia / Identidade visual e verbal / Experiência digital / Experiência física / Estratégia de comunicação",
  },
  {
    ghost: "conteúdo",
    name: "Conteúdo",
    text: "Produção estratégica que posiciona e converte. Estética a serviço da percepção de valor, não de vaidade.",
    tags: "Direção de arte / Vídeo / Linha editorial / Material gráfico / Campanhas",
  },
  {
    ghost: "performance",
    name: "Performance",
    text: "Captação ativa de clientes pro seu negócio. Conteúdo e estética que atraem receita de verdade, não só atenção.",
    tags: "Aquisição / Mídia paga / Funis / Leitura de dados / Campanhas / Automação",
  },
];

// ===== BRANDING — 5 motions de identidade (1:1, autoplay) =====
const brandingWork = [
  { name: "MaxFocos", meta: "Suplementos", video: "/videos/branding/maxfocos.mp4" },
  { name: "Biliart", meta: "Odontologia estética", video: "/videos/branding/biliart.mp4" },
  { name: "Biva", meta: "Arquitetura", video: "/videos/branding/biva.mp4" },
  { name: "Dela Bella", meta: "Beleza", video: "/videos/branding/delabela.mp4" },
  { name: "Kaju", meta: "Marca própria", video: "/videos/branding/kaju.mp4" },
];

// ===== CONTEÚDO — parede de reels 9:16 (pôster + clique) =====
// DADO: rótulos (cat/name) editáveis — confirmar cliente/tema de cada reel.
const reels = [
  { cat: "Odontologia", name: "As lentes que você deseja", file: "b27" },
  { cat: "Bastidor", name: "Vlog · Dia de cirurgia", file: "b49" },
  { cat: "Relato", name: "Cirurgia ortognática", file: "b50" },
  { cat: "Educativo", name: "Queixo: pra frente ou pra trás?", file: "b65" },
  { cat: "Depoimento", name: "Paciente", file: "depoimento" },
  { cat: "Educativo", name: "Diferença do alinhador", file: "id32" },
  { cat: "Educativo", name: "3 coisas antes da prótese", file: "lk18" },
  { cat: "Educativo", name: "Se o siso pode matar", file: "m55" },
  { cat: "Estética", name: "Lipo de papada", file: "m57" },
  { cat: "Educativo", name: "Plano de 6 meses", file: "m76" },
  { cat: "Depoimento", name: "Paciente", file: "mt06" },
  { cat: "Depoimento", name: "Paciente", file: "mt10" },
];

// ===== PERFORMANCE — resultados (1:1) + números =====
const perf = [
  { name: "MaxFocos", meta: "Lançamento", video: "/videos/campanhas/maxfocos.mp4" },
  { name: "Clínica LK", meta: "Campanha", video: "/videos/campanhas/lk.mp4" },
  { name: "Biva", meta: "Projeto", video: "/videos/campanhas/biva.mp4" },
];

// Experiências digitais (autoral) — 14 mockups 1:1 reais em /exp/.
const experiencias = Array.from({ length: 14 }, (_, i) => `/exp/${i + 1}.jpg`);
---

<Layout
  title="Nold Studio | Estúdio criativo de branding e performance"
  description="Construímos e escalamos marcas que não aceitam o genérico. Branding, conteúdo e performance numa esteira só, do posicionamento à receita."
  bodyClass="theme-v02"
>
  <!-- ============================ TOPBAR ============================ -->
  <header class="topbar" data-topbar>
    <div class="container topbar__inner">
      <a href="/" class="logo-morph" aria-label="Nold — início">
        <img class="logo-morph__word" src="/brand/wordmark-nold.png" width="320" height="167" alt="nold" />
        <img class="logo-morph__icon" src="/brand/symbol-pixel.png" width="200" height="200" alt="" aria-hidden="true" />
      </a>

      <div class="meta" data-nav-meta>
        <span class="meta__pair">São Paulo <b data-clock>--:--</b></span>
        <button class="copy-btn" type="button" data-copy={email} aria-label="Copiar e-mail">
          <span data-copy-label>{email}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" />
          </svg>
        </button>
      </div>

      <div class="nav-wrap" data-nav>
        <nav class="nav-pill" aria-label="Navegação principal">
          <a href="#trabalho">Projetos</a>
          <a href="#conteudo">Conteúdo</a>
          <a href={waLink} target="_blank" rel="noopener" class="hi">Olá! <span aria-hidden="true">💬</span></a>
        </nav>
        <button class="nav-burger" type="button" data-nav-toggle aria-label="Abrir menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <main>
    <!-- ============================ HERO ============================ -->
    <section class="hero container">
      <h1 class="hero__display">
        Seu negócio merece<br />
        ser <em>inevitável</em>.
      </h1>

      <p class="hero__sub">
        Construímos e escalamos marcas que não aceitam o genérico. Branding,
        conteúdo e performance numa esteira só — entregue com tecnologia, bom
        gosto e velocidade premium.
      </p>

      <div class="hero__actions">
        <a href="#estudio" class="text-link">
          Conheça o estúdio <span class="arw" aria-hidden="true">→</span>
        </a>
        <a href="#trabalho" class="text-link">
          Veja o trabalho <span class="arw" aria-hidden="true">→</span>
        </a>
        <span class="ball" data-ball aria-hidden="true"></span>
      </div>
    </section>

    <!-- ============ O APANHADO (colagem masonry, full-bleed) ============ -->
    <section class="collage-wrap" id="trabalho">
      <div class="collage">
        <!-- Macro-coluna esquerda: feature grande + par de identidades -->
        <div class="mcol">
          <article class="tile tile--sq">
            <video src="/videos/nold-entregas.mp4" autoplay loop muted playsinline preload="metadata"></video>
            <span class="tile__tag">Nold · Entregas</span>
          </article>
          <div class="pair">
            <article class="tile tile--sq">
              <video src="/videos/branding/kaju.mp4" autoplay loop muted playsinline preload="metadata"></video>
              <span class="tile__tag">Branding</span>
            </article>
            <article class="tile tile--sq">
              <video src="/videos/branding/biva.mp4" autoplay loop muted playsinline preload="metadata"></video>
              <span class="tile__tag">Branding</span>
            </article>
          </div>
        </div>

        <!-- Macro-coluna direita: identidade + performance MaxFocos lado a
             lado; verticais de conteúdo quase na primeira dobra -->
        <div class="mcol mcol--late">
          <div class="pair">
            <article class="tile tile--sq">
              <video src="/videos/branding/maxfocos.mp4" autoplay loop muted playsinline preload="metadata"></video>
              <span class="tile__tag">Branding</span>
            </article>
            <article class="tile tile--sq">
              <video src="/videos/campanhas/maxfocos-verde.mp4" autoplay loop muted playsinline preload="metadata"></video>
              <span class="tile__tag">Performance</span>
            </article>
          </div>
          <div class="pair">
            <article class="tile tile--v">
              <video src="/videos/reels/b50.mp4" autoplay loop muted playsinline preload="metadata"></video>
              <span class="tile__tag">Conteúdo</span>
            </article>
            <article class="tile tile--v">
              <video src="/videos/reels/m55.mp4" autoplay loop muted playsinline preload="metadata"></video>
              <span class="tile__tag">Conteúdo</span>
            </article>
          </div>
        </div>
      </div>

      <!-- Fecho: LK + marca (alinhados) à esquerda · copy à direita -->
      <div class="trio">
        <article class="tile tile--sq">
          <video src="/videos/campanhas/lk-verde.mp4" autoplay loop muted playsinline preload="metadata"></video>
          <span class="tile__tag">Performance</span>
        </article>
        <div class="brand-tile cta-box">
          <a class="cta-box__item cta-box__item--wa" href={waLink} target="_blank" rel="noopener">
            <span class="cta-box__label">Falar com um especialista</span>
            <span class="cta-box__arw" aria-hidden="true">→</span>
          </a>
          <a class="cta-box__item cta-box__item--form" href="#contato">
            <span class="cta-box__label">Começar um projeto</span>
            <span class="cta-box__arw" aria-hidden="true">↓</span>
          </a>
        </div>
        <div class="trio-copy">
          <p class="trio-copy__lead">
            Nosso trabalho é um só: fazer o seu negócio <em>gerar receita</em>.
            E a gente chega lá por três frentes.
          </p>
          <a class="trio-copy__link" href="#estudio">
            Ver como funciona <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ================= CLIENTES (marquee automático) ================= -->
    <section class="section container clients">
      <p class="eyebrow clients__label">Confiam na curadoria</p>
      <div class="marquee" aria-label="Clientes">
        {/* ASSET: trocar wordmarks por logos SVG reais */}
        <div class="marquee__track">
          <div class="marquee__group">
            {clients.map((c) => <span class="client-ph">{c}</span>)}
          </div>
          <div class="marquee__group" aria-hidden="true">
            {clients.map((c) => <span class="client-ph">{c}</span>)}
          </div>
        </div>
      </div>
    </section>

    <!-- ================= ESTÚDIO (manifesto escuro) ================= -->
    <section id="estudio">
      <div class="studio">
        <p class="studio__statement">
          Operamos numa esteira única — estratégia, <em>estética</em> e tecnologia
          juntas para construir marcas que despertam <em>desejo</em> e escalam <em>receita</em> de verdade.
        </p>

        <!-- ① BRANDING: descrição + identidades logo abaixo -->
        <div class="service" id="branding">
          <span class="service__ghost" aria-hidden="true">{services[0].ghost}</span>
          <div class="service__body">
            <p class="service__text">
              <em class="service__name">{services[0].name}</em><span class="reveal"> — {services[0].text}</span>
            </p>
            <p class="service__tags">{services[0].tags}</p>
            <div class="service__work service__work--b">
              {
                brandingWork.map((b) => (
                  <article class="tile tile--sq">
                    <video src={b.video} autoplay loop muted playsinline preload="metadata" />
                    <span class="tile__tag">{b.name}</span>
                  </article>
                ))
              }
            </div>
            <div class="cta-duo">
              <a class="btn btn--primary" href="#contato">Começar um projeto</a>
              <a class="btn btn--ghost" href={waLink} target="_blank" rel="noopener">Falar com um especialista</a>
            </div>
          </div>
        </div>

        <!-- ② CONTEÚDO: descrição + carrossel de reels dentro do quadrante -->
        <div class="service" id="conteudo">
          <span class="service__ghost" aria-hidden="true">{services[1].ghost}</span>
          <div class="service__body">
            <p class="service__text">
              <em class="service__name">{services[1].name}</em><span class="reveal"> — {services[1].text}</span>
            </p>
            <p class="service__tags">{services[1].tags}</p>
            <p class="reels-hint">Arraste para o lado · clique para assistir com som →</p>
            <div class="reels-strip reels-strip--in" data-reels>
              {
                reels.map((r) => (
                  <button class="reel-card" data-reel={`/videos/reels/${r.file}.mp4`} aria-label={`Assistir: ${r.name}`}>
                    <img class="reel-card__poster" src={`/videos/posters/${r.file}.jpg`} width="540" height="960" loading="lazy" alt="" />
                    <span class="reel-card__play" aria-hidden="true">▶</span>
                    <span class="tile__tag">{r.cat}</span>
                  </button>
                ))
              }
            </div>
            <div class="cta-duo">
              <a class="btn btn--primary" href="#contato">Começar um projeto</a>
              <a class="btn btn--ghost" href={waLink} target="_blank" rel="noopener">Falar com um especialista</a>
            </div>
          </div>
        </div>

        <!-- ③ PERFORMANCE: descrição + resultados logo abaixo -->
        <div class="service" id="performance">
          <span class="service__ghost" aria-hidden="true">{services[2].ghost}</span>
          <div class="service__body">
            <p class="service__text">
              <em class="service__name">{services[2].name}</em><span class="reveal"> — {services[2].text}</span>
            </p>
            <p class="service__tags">{services[2].tags}</p>
            <div class="service__work service__work--p">
              {
                perf.map((p) => (
                  <article class="tile tile--sq">
                    <video src={p.video} autoplay loop muted playsinline preload="metadata" />
                    <span class="tile__tag">{p.name}</span>
                  </article>
                ))
              }
            </div>
            <div class="cta-duo">
              <a class="btn btn--primary" href="#contato">Começar um projeto</a>
              <a class="btn btn--ghost" href={waLink} target="_blank" rel="noopener">Falar com um especialista</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ EXPERIÊNCIAS DIGITAIS (autoral, full-bleed) ============ -->
    <section class="section" id="autorais">
      <div class="container">
        <h2 class="autoral__head">
          Além das três frentes, criamos <em>experiências digitais</em> sob medida.
        </h2>
        <p class="autoral__sub">
          Sistemas de gestão, ferramentas próprias e as páginas dos nossos clientes.
          Software que vira vantagem competitiva. É o que está mais quente no estúdio.
        </p>
      </div>
      <div class="collage-wrap">
        <div class="exp-grid">
          {
            experiencias.map((src, i) => (
              <div class="exp-tile">
                <img src={src} width="720" height="720" loading="lazy" alt={`Experiência digital ${i + 1}`} />
              </div>
            ))
          }
        </div>
        <!-- banner cinematográfico full-bleed — filme Anacrônico -->
        <div class="banner">
          <video src="/videos/anacronico.mp4" autoplay loop muted playsinline preload="metadata"></video>
        </div>
      </div>
    </section>

    <!-- =========================== CTA =========================== -->
    <section class="section container cta" id="contato">
      <h2 class="cta__title">Sua marca merece<br />ser <em>inevitável</em>.</h2>
      <p class="cta__lead">
        Para empresas que faturam <strong>acima de R$ 100 mil por mês</strong> e
        querem escalar seus resultados financeiros.
      </p>

      <form class="lead-form" data-lead data-email={formEmail} action={`https://formsubmit.co/${formEmail}`} method="POST">
        <input type="hidden" name="_subject" value="Novo lead — site Nold 🚀" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" class="lead-form__honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="lead-form__grid">
          <label class="field">
            <span>Nome</span>
            <input type="text" name="Nome" required placeholder="Seu nome" />
          </label>
          <label class="field">
            <span>Empresa</span>
            <input type="text" name="Empresa" required placeholder="Nome da empresa" />
          </label>
          <label class="field">
            <span>Instagram</span>
            <input type="text" name="Instagram" placeholder="@suaempresa" />
          </label>
          <label class="field">
            <span>WhatsApp</span>
            <input type="tel" name="WhatsApp" required placeholder="(11) 99999-9999" />
          </label>
          <label class="field">
            <span>E-mail</span>
            <input type="email" name="E-mail" required placeholder="voce@empresa.com" />
          </label>
          <label class="field">
            <span>Segmento</span>
            <select name="Segmento" required>
              <option value="" disabled selected>Selecione</option>
              {segmentos.map((s) => <option value={s}>{s}</option>)}
            </select>
          </label>
          <label class="field field--full">
            <span>Onde está o problema e o que você deseja?</span>
            <textarea name="Mensagem" rows="4" required placeholder="Conte rapidamente o seu momento e o seu objetivo."></textarea>
          </label>
        </div>

        <div class="lead-form__foot">
          <button type="submit" class="btn btn--primary btn--lg">Quero ser inevitável →</button>
          <p class="lead-form__status" data-lead-status aria-live="polite"></p>
        </div>
      </form>
    </section>
  </main>

  <!-- ============================ FOOTER ============================ -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer__top">
        <div class="footer__brand">
          <img class="footer__logo" src="/brand/wordmark-lockup.png" width="600" height="395" alt="nold — studio criativo" />
        </div>
        <div class="footer__col">
          <h4>Navegação</h4>
          <ul>
            <li><a href="#trabalho">Trabalho</a></li>
            <li><a href="#branding">Branding</a></li>
            <li><a href="#conteudo">Conteúdo</a></li>
            <li><a href="#performance">Performance</a></li>
          </ul>
        </div>
        <div class="footer__col">
          <h4>Social</h4>
          <ul>
            <li><a href={instagram} target="_blank" rel="noopener">Instagram ↗</a></li>
          </ul>
        </div>
      </div>
      <div class="footer__bottom">
        <span>© 2026 Nold Studio</span>
        <span>Beleza estratégica</span>
      </div>
    </div>
  </footer>

  <!-- ========================= LIGHTBOX ========================= -->
  <div class="lightbox" data-lightbox hidden>
    <button class="lightbox__close" data-lb-close aria-label="Fechar">✕</button>
    <video class="lightbox__video" data-lb-video controls playsinline></video>
  </div>

  <!-- ===================== CURSOR (bolinha) ===================== -->
  <div class="cursor" data-cursor aria-hidden="true"></div>
</Layout>

<script>
  // Relógio de São Paulo
  const fmt = new Intl.DateTimeFormat("pt-BR", {
    hour: "2-digit", minute: "2-digit", timeZone: "America/Sao_Paulo",
  });
  function tick() {
    document.querySelectorAll("[data-clock]").forEach((el) => {
      el.textContent = fmt.format(new Date());
    });
  }
  tick();
  setInterval(tick, 15000);

  // Copiar e-mail
  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.getAttribute("data-copy"));
        const label = btn.querySelector("[data-copy-label]") || btn;
        const old = label.textContent;
        label.textContent = "copiado ✓";
        setTimeout(() => (label.textContent = old), 1400);
      } catch (e) {}
    });
  });

  // Formulário de lead → FormSubmit (AJAX), com status inline
  const leadForm = document.querySelector("[data-lead]");
  if (leadForm) {
    const status = leadForm.querySelector("[data-lead-status]");
    const btn = leadForm.querySelector('button[type="submit"]');
    leadForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (leadForm.querySelector('[name="_honey"]').value) return; // honeypot
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = "Enviando…";
      status.classList.remove("is-error");
      status.textContent = "";
      try {
        const payload = Object.fromEntries(new FormData(leadForm));
        const res = await fetch("https://formsubmit.co/ajax/" + leadForm.dataset.email, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (String(data.success) === "true") {
          leadForm.reset();
          status.textContent = "Recebido! A gente te retorna em breve. 🚀";
        } else {
          throw new Error(data.message || "erro");
        }
      } catch (err) {
        status.classList.add("is-error");
        status.textContent = "Não deu pra enviar agora — tenta pelo WhatsApp?";
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  }

  // Reveal palavra-a-palavra. .reveal contém só texto puro -> split limpo.
  const reveals = Array.from(document.querySelectorAll(".reveal"));
  reveals.forEach((el) => {
    if (el.dataset.r) return; // idempotente (evita corromper em HMR)
    const text = el.textContent;
    el.textContent = "";
    text.split(/(\s+)/).forEach((tok) => {
      if (tok.trim() === "") el.appendChild(document.createTextNode(tok));
      else {
        const s = document.createElement("span");
        s.className = "w";
        s.textContent = tok;
        el.appendChild(s);
      }
    });
    el.dataset.r = "1";
    el.classList.add("is-ready");
  });

  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const vh = window.innerHeight;
      reveals.forEach((el) => {
        const ws = el.querySelectorAll(".w");
        const r = el.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (vh * 0.72 - r.top) / (r.height || 1)));
        const n = Math.round(p * ws.length);
        ws.forEach((w, i) => w.classList.toggle("on", i < n));
      });
      ticking = false;
    });
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
  onScroll();

  // Lightbox dos reels (carrega o vídeo só no clique)
  const lb = document.querySelector("[data-lightbox]");
  const lbVideo = document.querySelector("[data-lb-video]");
  function openLB(src) {
    if (!lb || !lbVideo) return;
    lbVideo.src = src;
    lb.hidden = false;
    document.body.style.overflow = "hidden";
    lbVideo.play().catch(() => {});
  }
  function closeLB() {
    if (!lb || !lbVideo) return;
    lbVideo.pause();
    lbVideo.removeAttribute("src");
    lbVideo.load();
    lb.hidden = true;
    document.body.style.overflow = "";
  }
  document.querySelectorAll("[data-reel]").forEach((b) => {
    b.addEventListener("click", () => openLB(b.getAttribute("data-reel")));
  });
  document.querySelector("[data-lb-close]")?.addEventListener("click", closeLB);
  lb?.addEventListener("click", (e) => { if (e.target === lb) closeLB(); });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && lb && !lb.hidden) closeLB();
  });

  // Topbar: colapsa no scroll (meta some, pill vira hambúrguer)
  const topbar = document.querySelector("[data-topbar]");
  const navWrap = document.querySelector("[data-nav]");
  const navToggle = document.querySelector("[data-nav-toggle]");
  function closeNav() {
    navWrap?.classList.remove("is-open");
    navToggle?.setAttribute("aria-expanded", "false");
  }
  function onNavScroll() {
    if (!topbar) return;
    const scrolled = window.scrollY > 40;
    topbar.classList.toggle("is-scrolled", scrolled);
    if (!scrolled) closeNav();
  }
  navToggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    const open = navWrap.classList.toggle("is-open");
    navToggle.setAttribute("aria-expanded", String(open));
  });
  navWrap?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeNav));
  document.addEventListener("click", (e) => {
    if (navWrap && !navWrap.contains(e.target)) closeNav();
  });
  window.addEventListener("scroll", onNavScroll, { passive: true });
  onNavScroll();

  // Cursor bolinha (só em ponteiro fino)
  const cursor = document.querySelector("[data-cursor]");
  if (cursor && matchMedia("(hover: hover) and (pointer: fine)").matches) {
    document.documentElement.classList.add("has-cursor");
    let x = innerWidth / 2, y = innerHeight / 2, cx = x, cy = y;
    addEventListener("pointermove", (e) => { x = e.clientX; y = e.clientY; }, { passive: true });
    (function loop() {
      cx += (x - cx) * 0.22; cy += (y - cy) * 0.22;
      cursor.style.transform = `translate(${cx}px, ${cy}px) translate(-50%, -50%)`;
      requestAnimationFrame(loop);
    })();
    const hoverSel = "a, button, .tile, .reel-card, input, [data-ball]";
    document.querySelectorAll(hoverSel).forEach((el) => {
      el.addEventListener("pointerenter", () => cursor.classList.add("is-hover"));
      el.addEventListener("pointerleave", () => cursor.classList.remove("is-hover"));
    });
  }

  // Tilt 3D nas caixas do apanhado (só ponteiro fino; respeita reduced-motion)
  if (
    matchMedia("(hover: hover) and (pointer: fine)").matches &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const MAX = 9;
    document.querySelectorAll("#trabalho .tile, #trabalho .brand-tile, #autorais .exp-tile").forEach((card) => {
      card.addEventListener("pointerenter", () => {
        card.style.transition = "transform 0.12s linear, box-shadow 0.3s var(--ease)";
      });
      card.addEventListener("pointermove", (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform =
          `perspective(900px) rotateX(${(-py * MAX).toFixed(2)}deg) rotateY(${(px * MAX).toFixed(2)}deg) scale(1.02)`;
        card.style.setProperty("--mx", `${((px + 0.5) * 100).toFixed(1)}%`);
        card.style.setProperty("--my", `${((py + 0.5) * 100).toFixed(1)}%`);
        card.classList.add("is-tilting");
      });
      card.addEventListener("pointerleave", () => {
        card.style.transition = "transform 0.55s var(--ease), box-shadow 0.55s var(--ease)";
        card.style.transform = "";
        card.classList.remove("is-tilting");
      });
    });
  }

  // Bolinha “física” arrastável (detalhe lúdico)
  document.querySelectorAll("[data-ball]").forEach((ball) => {
    let dragging = false, sx = 0, sy = 0, x = 0, y = 0;
    ball.addEventListener("pointerdown", (e) => {
      dragging = true; sx = e.clientX - x; sy = e.clientY - y;
      ball.setPointerCapture(e.pointerId);
    });
    ball.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      x = e.clientX - sx; y = e.clientY - sy;
      ball.style.transform = `translate(${x}px, ${y}px)`;
    });
    ball.addEventListener("pointerup", () => {
      dragging = false;
      ball.style.transition = "transform .6s cubic-bezier(.22,1,.36,1)";
      ball.style.transform = "translate(0,0)";
      x = 0; y = 0;
      setTimeout(() => (ball.style.transition = ""), 600);
    });
  });
</script>
